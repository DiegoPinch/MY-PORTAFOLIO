---
import type { Tone } from '../types/content';
import { badgeClasses } from '../utils/styles';
interface Props {
  tone?: Tone;
  class?: string;
}
const { tone, class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded border px-2 py-1 font-mono text-sm leading-relaxed',
    tone ? badgeClasses[tone] : 'border-transparent bg-subtle text-body',
    className,
  ]}
>
  <slot />
</span>
