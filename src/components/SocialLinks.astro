---
import BrandIcon from './BrandIcon.astro';

interface SocialLink {
  label: string;
  href: string;
  icon: 'github' | 'linkedin' | 'whatsapp';
}

interface Props {
  links: readonly SocialLink[];
}

const { links } = Astro.props;
---

<nav aria-label="Redes sociales" class="flex gap-2.5">
  {links.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Abrir ${link.label} de Diego`}
      title={link.label}
      class:list={['social-link', link.icon === 'whatsapp' && 'social-link-whatsapp']}
    >
      <BrandIcon name={link.icon} size={21} />
    </a>
  ))}
</nav>

<style>
  .social-link {
    display: inline-flex;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    color: var(--body);
    box-shadow: 0 8px 22px rgb(0 0 0 / 12%);
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      color 220ms ease;
  }

  .social-link:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    color: var(--accent);
    box-shadow:
      0 12px 26px rgb(0 0 0 / 18%),
      0 0 18px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .social-link-whatsapp:hover {
    border-color: color-mix(in srgb, var(--emerald) 55%, var(--line));
    color: var(--emerald);
    box-shadow:
      0 12px 26px rgb(0 0 0 / 18%),
      0 0 18px color-mix(in srgb, var(--emerald) 20%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link {
      transition: none;
    }
    .social-link:hover {
      transform: none;
    }
  }
</style>
