---
import { profile } from '../data/profile';
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile/diego-pincha.png';
---

<div class="mx-auto w-full max-w-[340px]">
  <aside
    aria-label="Fotografía de perfil"
    class="portrait-card w-full overflow-hidden rounded-2xl border border-line bg-card p-2"
  >
    <div class="relative aspect-[4/4.6] overflow-hidden rounded-xl bg-card">
      <Image
        src={profilePhoto}
        alt={`Retrato profesional de ${profile.name}`}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 340px, (min-width: 380px) 340px, calc(100vw - 2.5rem)"
        format="webp"
        loading="eager"
        decoding="async"
        style="width: 100%; height: 100%;"
        class="portrait-photo absolute inset-0 h-full w-full object-cover object-center"
      />
      <span class="portrait-sheen pointer-events-none absolute inset-0" aria-hidden="true"></span>
    </div>
  </aside>
</div>

<style>
  .portrait-card {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    transform: perspective(900px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transform-style: preserve-3d;
    animation: portrait-glow 7s ease-in-out infinite alternate;
    transition:
      transform 600ms cubic-bezier(0.2, 0.75, 0.25, 1),
      border-color 600ms ease;
  }

  .portrait-photo {
    transition: transform 900ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .portrait-sheen {
    background: linear-gradient(
      110deg,
      transparent 35%,
      rgb(255 255 255 / 22%) 50%,
      transparent 65%
    );
    opacity: 0;
    transform: translateX(-110%);
    transition:
      transform 1100ms ease,
      opacity 350ms ease;
  }

  .portrait-card:hover {
    transform: perspective(900px) translateY(-5px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
  }

  .portrait-card:hover .portrait-photo {
    transform: scale(1.035);
  }

  .portrait-card:hover .portrait-sheen {
    opacity: 1;
    transform: translateX(110%);
  }

  @keyframes portrait-glow {
    from {
      box-shadow:
        0 18px 48px rgb(0 0 0 / 16%),
        0 0 0 color-mix(in srgb, var(--accent) 0%, transparent);
    }
    to {
      box-shadow:
        0 22px 52px rgb(0 0 0 / 18%),
        0 0 26px color-mix(in srgb, var(--accent) 13%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait-card,
    .portrait-photo,
    .portrait-sheen {
      animation: none;
      transition: none;
    }

    .portrait-card:hover,
    .portrait-card:hover .portrait-photo {
      transform: none;
    }

    .portrait-card:hover .portrait-sheen {
      opacity: 0;
    }
  }
</style>

<script>
  const card = document.querySelector<HTMLElement>('.portrait-card');
  if (card && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const reset = () => {
      card.style.setProperty('--tilt-x', '0deg');
      card.style.setProperty('--tilt-y', '0deg');
    };
    card.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      const bounds = card.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - 0.5;
      const y = (event.clientY - bounds.top) / bounds.height - 0.5;
      card.style.setProperty('--tilt-x', `${y * -5}deg`);
      card.style.setProperty('--tilt-y', `${x * 6}deg`);
    });
    card.addEventListener('pointerleave', reset);
  }
</script>
