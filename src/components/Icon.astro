---
import {
  ArrowRight,
  ArrowUpRight,
  ArrowDown,
  Layers,
  LockKeyhole,
  Box,
  CodeXml,
  Mail,
  Phone,
  MapPin,
  BriefcaseBusiness,
  Download,
  MessageCircle,
  Sun,
  Moon,
  Menu,
  X,
  Award,
  Network,
  Languages,
  Terminal,
  GraduationCap,
  Check,
  Copy,
  Send,
  ImageOff,
  Music,
  Quote,
} from '@lucide/astro';
import type { IconName } from '../types/content';
interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
const icons = {
  'arrow-right': ArrowRight,
  'arrow-up-right': ArrowUpRight,
  'arrow-down': ArrowDown,
  layers: Layers,
  lock: LockKeyhole,
  box: Box,
  code: CodeXml,
  mail: Mail,
  phone: Phone,
  'map-pin': MapPin,
  github: CodeXml,
  linkedin: BriefcaseBusiness,
  download: Download,
  message: MessageCircle,
  sun: Sun,
  moon: Moon,
  menu: Menu,
  close: X,
  award: Award,
  network: Network,
  languages: Languages,
  terminal: Terminal,
  graduation: GraduationCap,
  check: Check,
  copy: Copy,
  send: Send,
  image: ImageOff,
  music: Music,
  quote: Quote,
};
const Glyph = icons[name];
---

<Glyph size={size} stroke-width={1.7} class:list={['shrink-0', className]} aria-hidden="true" />
