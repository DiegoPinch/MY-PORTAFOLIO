---
import type { Project } from '../types/content';
import { profile } from '../data/profile';
import { toneClasses } from '../utils/styles';
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article
  id={`project-${project.id}`}
  class:list={[
    'overflow-hidden rounded-2xl border border-line bg-card transition-colors hover:border-accent/25',
    project.featured ? 'md:col-span-2' : 'flex flex-col',
  ]}
>
  <div class:list={[project.featured && 'grid lg:grid-cols-12', !project.featured && 'h-full']}>
    <div
      class:list={[
        'flex h-full flex-col justify-between p-6 sm:p-8',
        project.featured && 'lg:col-span-7 lg:p-9',
      ]}
    >
      <div>
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
          <Badge tone={project.tone}>{project.category}</Badge>
          <span class="font-mono text-[10px] text-muted">{project.context}</span>
        </div>
        <h3
          class:list={[
            'mb-4 font-bold leading-snug tracking-tight text-heading',
            project.featured ? 'text-2xl' : 'text-xl',
          ]}
        >
          {project.title}
        </h3>
        <p class="text-sm leading-relaxed">{project.description}</p>
        {project.image && (
          <div class="mt-6">
            <ResponsiveImage image={project.image} fallback={project.title} />
          </div>
        )}
        {project.facts && (
          <dl class="mt-6 grid gap-5 border-t border-line pt-5 sm:grid-cols-3">
            {project.facts.map((fact, i) => (
              <div>
                <dt
                  class:list={[
                    'mb-2 font-mono text-[10px] uppercase',
                    i === 2 ? 'text-accent' : 'text-muted',
                  ]}
                >
                  {fact.label}
                </dt>
                <dd class="text-xs leading-relaxed text-body">{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {project.process && (
          <div class="mt-6 rounded-lg border border-line bg-inset p-4 font-mono text-[10px]">
            <div class="flex flex-wrap justify-between gap-3">
              <span class="uppercase text-muted">{project.process.label}</span>
              <span class:list={[toneClasses[project.tone]]}>{project.process.value}</span>
            </div>
            <div
              class:list={[
                'my-3 h-1 rounded-full bg-current opacity-65',
                toneClasses[project.tone],
              ]}
              aria-hidden="true"
            ></div>
            <div class="flex flex-wrap justify-between gap-2 text-muted">
              <span>{project.process.stack}</span>
              <span>{project.process.detail}</span>
            </div>
          </div>
        )}
      </div>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-5 border-t border-line pt-5">
        <ul aria-label="Tecnologías del proyecto" class="flex flex-wrap gap-1.5">
          {project.tags.map((tag) => (
            <li>
              <Badge>{tag}</Badge>
            </li>
          ))}
        </ul>
        <a
          href={
            project.repository ??
            `${profile.cvRequest}&body=${encodeURIComponent(`Hola Diego, quisiera conocer más sobre ${project.title}.`)}`
          }
          target={project.repository ? '_blank' : undefined}
          rel={project.repository ? 'noopener noreferrer' : undefined}
          class="inline-flex min-h-11 items-center gap-2 font-mono text-xs text-heading hover:text-accent"
        >
          {project.repository ? 'Ver repositorio' : 'Consultar proyecto'}
          <Icon name="arrow-up-right" size={15} />
        </a>
      </div>
    </div>
    {project.featured && project.layers && (
      <div class="border-t border-line lg:col-span-5 lg:border-l lg:border-t-0">
        <ArchitectureDiagram layers={project.layers} />
      </div>
    )}
  </div>
</article>
