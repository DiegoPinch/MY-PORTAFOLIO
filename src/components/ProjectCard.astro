---
import type { Project } from '../types/content';
import { profile } from '../data/profile';
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const imageUrl =
  project.image &&
  (typeof project.image.src === 'string' ? project.image.src : project.image.src.src);
---

<article
  id={`project-${project.id}`}
  class="flex min-w-0 scroll-mt-24 flex-col overflow-hidden rounded-xl border border-line bg-card transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1 hover:border-accent/35 hover:shadow-[0_14px_35px_-20px_color-mix(in_srgb,var(--accent)_55%,transparent)]"
>
  {project.image && (
    <div class="project-preview border-b border-line">
      <ResponsiveImage image={project.image} fallback={project.title} aspectRatio="16 / 9" />
    </div>
  )}
  <div class="flex flex-1 flex-col p-5">
    <p class="mb-3 text-sm font-medium text-accent">{project.category}</p>
    <h3 class="text-xl font-semibold leading-snug text-heading">{project.title}</h3>
    <p class="mb-4 mt-3 text-base leading-relaxed text-body">
      {project.summary ?? project.description}
    </p>
    <ul aria-label="Tecnologías principales del proyecto" class="mb-4 flex flex-wrap gap-1.5">
      {project.tags.slice(0, 3).map((tag) => (
        <li>
          <Badge>{tag}</Badge>
        </li>
      ))}
    </ul>
    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-line pt-2">
      {project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link text-accent"
          aria-label={`Visitar ${project.title}`}
        >
          Visitar web <Icon name="arrow-up-right" size={16} />
        </a>
      )}
      {project.repository && (
        <a
          href={project.repository}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link"
          aria-label={`Ver código de ${project.title}`}
        >
          Ver código <BrandIcon name="github" size={17} />
        </a>
      )}
      {project.privateCode && !project.repository && (
        <span class="project-link text-muted" title="El código fuente no es público">
          <Icon name="lock" size={16} />
          Código privado
        </span>
      )}
      {imageUrl && (
        <a
          href={imageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link"
          aria-label={`Ampliar imagen de ${project.title}`}
        >
          Ver imagen <Icon name="arrow-up-right" size={16} />
        </a>
      )}
      {!project.url && !project.repository && !project.privateCode && (
        <a
          href={`mailto:${profile.email}?subject=${encodeURIComponent(`Consulta sobre ${project.title}`)}`}
          class="project-link"
        >
          Consultar proyecto <Icon name="arrow-right" size={16} />
        </a>
      )}
    </div>
  </div>
</article>
<style>
  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .project-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .project-preview :global(.media-frame) {
    border-radius: 0;
  }
  .project-preview :global(img) {
    object-position: top;
  }
</style>
