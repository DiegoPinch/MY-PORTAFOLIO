---
import { profile } from '../data/profile';
---

<footer class="border-t border-line bg-inset py-9">
  <div class="page-container flex flex-col justify-between gap-5 font-mono text-[11px] leading-relaxed text-muted md:flex-row">
    <p>
      <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-emerald" aria-hidden="true"></span>
      {profile.name} © {new Date().getFullYear()}
      <br class="sm:hidden" /> · {profile.role}
    </p>
    <div class="flex flex-wrap items-center gap-5">
      <a href="#inicio" class="py-2 hover:text-accent">
        Volver arriba ↑
      </a>
      <span>{profile.location}</span>
    </div>
  </div>
</footer>
