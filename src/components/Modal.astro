---
import Icon from './Icon.astro';
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  class="m-auto max-h-[85dvh] w-[calc(100%-2rem)] max-w-2xl overflow-y-auto rounded-2xl border border-line bg-card p-5 shadow-2xl sm:p-8"
>
  <div class="mb-5 flex items-start justify-between gap-4 border-b border-line pb-4">
    <h3 id={`${id}-title`} class="pt-2 text-lg font-semibold text-heading">
      {title}
    </h3>
    <button
      type="button"
      class="icon-button shrink-0"
      data-close-dialog
      aria-label="Cerrar diálogo"
      autofocus
    >
      <Icon name="close" />
    </button>
  </div>
  <slot />
</dialog>
