---
import { contactTopics } from '../data/sections';
import { profile } from '../data/profile';
import Icon from './Icon.astro';
---

<div class="rounded-2xl border border-line bg-card p-6 sm:p-8">
  <form
    id="contact-form"
    data-recipient={profile.email}
    action={`mailto:${profile.email}`}
    method="get"
    class="space-y-5"
    aria-describedby="contact-help"
  >
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class="field-label" for="contact-name">
          Nombre completo
        </label>
        <input
          class="field"
          id="contact-name"
          name="name"
          autocomplete="name"
          placeholder="Tu nombre o empresa"
          required
          minlength="2"
          maxlength="120"
        />
      </div>
      <div>
        <label class="field-label" for="contact-email">
          Correo electrónico
        </label>
        <input
          class="field"
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="contacto@tuempresa.com"
          required
          maxlength="254"
        />
      </div>
    </div>
    <div>
      <label class="field-label" for="contact-topic">
        Motivo del contacto
      </label>
      <select class="field" id="contact-topic" name="topic">
        {contactTopics.map((topic) => (
          <option value={topic}>{topic}</option>
        ))}
      </select>
    </div>
    <div>
      <label class="field-label" for="contact-message">
        Mensaje / Detalle de la propuesta
      </label>
      <textarea
        class="field min-h-36 resize-y"
        id="contact-message"
        name="message"
        placeholder="Cuéntame sobre el puesto, proyecto o tecnologías requeridas…"
        required
        minlength="10"
        maxlength="4000"
        rows="5"
      ></textarea>
    </div>
    <p id="contact-help" class="text-xs leading-relaxed text-muted">
      Al continuar se abrirá tu aplicación de correo con el mensaje preparado. Podrás revisarlo y
      enviarlo desde allí.
    </p>
    <button
      type="submit"
      class="flex min-h-12 w-full items-center justify-center gap-3 rounded-lg bg-heading px-5 py-3 text-xs font-semibold uppercase tracking-wide text-canvas transition-opacity hover:opacity-85"
    >
      Preparar correo para Diego
      <Icon name="send" size={16} />
    </button>
    <p
      id="form-feedback"
      role="status"
      aria-live="polite"
      class="text-xs leading-relaxed text-accent"
    ></p>
  </form>
</div>
