---
import { profile } from '../data/profile';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import EngineeringCard from '../components/EngineeringCard.astro';
---

<section
  id="inicio"
  aria-labelledby="hero-title"
  class="grid items-center gap-12 border-b border-line pb-16 pt-12 sm:pb-20 lg:grid-cols-12 lg:gap-14 lg:pt-20"
>
  <div class="min-w-0 lg:col-span-7">
    <p class="mb-7 inline-flex items-center gap-2.5 rounded-full border border-line bg-card px-3 py-2 font-mono text-[10px] leading-relaxed text-body">
      <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald" aria-hidden="true"></span>
      {profile.availability}
    </p>
    <h1
      id="hero-title"
      class="max-w-2xl text-4xl font-extrabold leading-[1.12] tracking-tight text-heading sm:text-5xl lg:text-[52px]"
    >
      {profile.name}
    </h1>
    <p class="mt-5 text-lg font-medium leading-relaxed text-accent sm:text-xl">
      {profile.headline}
    </p>
    <div class="mt-5 flex flex-wrap gap-x-4 gap-y-3 font-mono text-[10px] text-muted">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="map-pin" size={14} class="text-accent" />
        {profile.location}
      </span>
      <a href={profile.phoneHref} class="inline-flex items-center gap-1.5 hover:text-heading">
        <Icon name="phone" size={14} class="text-emerald" />
        {profile.phone}
      </a>
      <a
        href={`mailto:${profile.email}`}
        class="inline-flex items-center gap-1.5 hover:text-heading"
      >
        <Icon name="mail" size={14} class="text-indigo" />
        {profile.email}
      </a>
    </div>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-body">{profile.summary}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="#proyectos" icon="arrow-right">
        Ver proyectos
      </Button>
      <Button href="#contacto" variant="secondary" icon="message">
        Iniciar conversación
      </Button>
    </div>
    <dl class="mt-10 grid grid-cols-2 gap-x-4 gap-y-6 border-t border-line pt-6 sm:grid-cols-4">
      {profile.metrics.map((metric, index) => (
        <div class="flex flex-col">
          <dt class="mt-1 text-[10px] leading-relaxed text-muted">{metric.label}</dt>
          <dd
            class:list={[
              '-order-1 mb-1 font-mono text-xl font-bold tracking-tight',
              index % 2 ? 'text-accent' : 'text-heading',
            ]}
          >
            {metric.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="lg:col-span-5">
    <EngineeringCard />
  </div>
</section>
