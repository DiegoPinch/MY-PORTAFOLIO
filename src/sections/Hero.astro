---
import { profile, socialLinks } from '../data/profile';
import Button from '../components/Button.astro';
import EngineeringCard from '../components/EngineeringCard.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<section
  id="inicio"
  aria-labelledby="hero-title"
  class="grid items-center gap-10 border-b border-line py-10 sm:py-14 lg:grid-cols-12 lg:gap-12"
>
  <div class="min-w-0 lg:col-span-7">
    <p class="eyebrow mb-5">Artist / Developer · Quito, Ecuador</p>
    <h1
      id="hero-title"
      class="text-4xl font-extrabold leading-[1.05] tracking-tight text-heading sm:text-5xl lg:text-6xl"
    >
      {profile.heroName}
    </h1>
    <p class="mt-6 text-lg font-medium leading-relaxed text-body sm:text-xl">{profile.heroIntro}</p>
    <p class="mt-3 text-base leading-relaxed text-muted">{profile.heroProof}</p>
    <p class="mt-5 font-mono text-sm tracking-wide text-accent">
      .NET · Angular · Blazor · APIs REST
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="#proyectos" icon="arrow-right">
        Ver proyectos
      </Button>
      <Button href="#contacto" variant="secondary" icon="message">
        Iniciar conversación
      </Button>
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-4 border-t border-line pt-5">
      <SocialLinks links={socialLinks} />
      <a
        href={`mailto:${profile.email}`}
        class="inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-accent"
      >
        <Icon name="mail" size={15} />
        {profile.email}
      </a>
    </div>
  </div>
  <div class="hidden lg:col-span-5 lg:block">
    <EngineeringCard />
  </div>
</section>
