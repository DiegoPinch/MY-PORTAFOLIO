---
import { profile } from '../data/profile';
import { headings } from '../data/sections';
import SectionHeader from '../components/SectionHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
---

<section id="contacto" aria-labelledby="contact-title" class="py-16 sm:py-20">
  <SectionHeader heading={headings.contact} id="contact-title" />
  <div class="grid gap-8 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-5">
      <dl class="divide-y divide-line rounded-xl border border-line bg-card px-5 sm:px-6">
        <div class="py-5">
          <dt class="field-label">Correo electrónico</dt>
          <dd class="flex flex-wrap items-center justify-between gap-2">
            <a
              href={`mailto:${profile.email}`}
              class="select-all break-all font-mono text-sm text-heading hover:text-accent"
            >
              {profile.email}
            </a>
            <button
              type="button"
              data-copy-email={profile.email}
              class="inline-flex min-h-11 items-center gap-2 rounded px-2 font-mono text-xs text-body hover:text-accent"
            >
              <Icon name="copy" size={14} />
              <span data-copy-label>Copiar</span>
            </button>
          </dd>
        </div>
        <div class="py-5">
          <dt class="field-label">Teléfono / WhatsApp</dt>
          <dd class="flex flex-wrap items-center justify-between gap-3">
            <a href={profile.phoneHref} class="font-mono text-sm text-heading">
              {profile.phone}
            </a>
            <a
              href={profile.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded bg-emerald/10 px-3 font-mono text-xs text-emerald"
            >
              WhatsApp →
            </a>
          </dd>
        </div>
        <div class="py-5">
          <dt class="field-label">Ubicación y disponibilidad</dt>
          <dd>
            <p class="text-sm text-heading">{profile.location}</p>
            <p class="mt-2 text-xs leading-relaxed text-muted">{profile.modality}</p>
          </dd>
        </div>
      </dl>
      <p id="copy-feedback" role="status" aria-live="polite" class="mt-2 text-xs text-accent"></p>
      <div class="mt-4 grid grid-cols-2 gap-3">
        {[
          { name: 'LinkedIn', href: profile.linkedin },
          { name: 'GitHub', href: profile.github },
        ].map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 items-center justify-center gap-2 rounded-lg border border-line bg-card px-4 font-mono text-xs text-body hover:border-accent/40 hover:text-accent"
          >
            {link.name}
            <Icon name="arrow-up-right" size={14} />
          </a>
        ))}
      </div>
    </div>
    <div class="min-w-0 lg:col-span-7">
      <ContactForm />
    </div>
  </div>
</section>
